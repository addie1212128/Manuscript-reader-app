# ─────────────────────────────────────────────────────────────
# Manuscript Reader — configuration
#
# Copy this file to ".env" and fill in a key for whichever voice
# provider you want to use. You only need ONE. If you leave both
# blank, the app still runs in free "Demo" mode so you can try it.
# ─────────────────────────────────────────────────────────────

# OpenAI (good value, very natural). Get a key at:
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ElevenLabs (the most human-sounding, audiobook-grade). Get a key at:
#   https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ─────────────────────────────────────────────────────────────
# Passcode — IMPORTANT if you deploy this to the public internet.
# Set this to a long, unique passphrase or a randomly generated secret
# (NOT a common word — it's the only thing guarding your provider credits).
# Anyone opening the app must enter it before they can generate audio.
# The server also rate-limits wrong guesses. Leave it blank when running
# privately on your own machine.
# Tip: generate a strong one with:  openssl rand -base64 24
# ─────────────────────────────────────────────────────────────
APP_PASSCODE=

# Set to 1 ONLY when the app runs behind a trusted reverse proxy (Render, a
# load balancer, nginx, etc.) so the passcode rate limiter sees real client IPs.
# Leave unset for direct local/Docker runs — otherwise clients could spoof their
# IP via X-Forwarded-For and dodge the limiter. (Render's blueprint sets this.)
TRUST_PROXY_HOPS=

# Port the app runs on (optional).
PORT=3000
